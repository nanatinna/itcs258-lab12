# Template for running the API in Docker.
# Copy to .env.docker, then fill in the real password and JWT secret.
# Inside a container, "localhost" is the container itself, so use host.docker.internal
# to reach MySQL and Redis running on your Windows machine.

PORT=3000
DATABASE_URL=mysql://Admin_ICTHotel:CHANGE_ME@host.docker.internal:3306/ICTHotel?allowPublicKeyRetrieval=true
REDIS_URL=redis://host.docker.internal:6379
JWT_SECRET="itcs258-lab-dev-secret-change-me"
JWT_EXPIRES_IN_SECONDS=3600